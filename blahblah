local activeThemeName = "Vantix"
local K = {}
for k, v in pairs(THEMES.Vantix) do
	K[k] = v
end

local themeUpdaters = {}
local updatersSincePrune = 0
local function pruneThemeUpdaters()
	local alive = {}
	for _, item in ipairs(themeUpdaters) do
		if not item.target or item.target.Parent then alive[#alive + 1] = item end
	end
	themeUpdaters = alive
end
local function registerThemeUpdater(callback, targetInstance)
	table.insert(themeUpdaters, {cb = callback, target = targetInstance})
	updatersSincePrune = updatersSincePrune + 1
	if updatersSincePrune >= 300 then
		updatersSincePrune = 0
		pruneThemeUpdaters()
	end
	pcall(callback)
end

local function refreshThemeUpdaters()
	local activeUpdaters = {}
	for _, item in ipairs(themeUpdaters) do
		local keep = true
		if item.target and not item.target.Parent then
			keep = false
		end
		if keep then
			table.insert(activeUpdaters, item)
			pcall(item.cb)
		end
	end
	themeUpdaters = activeUpdaters
end

local function setTheme(themeName)
	if not THEMES[themeName] then return end
	activeThemeName = themeName
	local theme = THEMES[themeName]
	for k, v in pairs(theme) do
		K[k] = v
	end
	refreshThemeUpdaters()
end

local function shade(color, factor)
	local h, s, v = color:ToHSV()
	v = math.clamp(v * factor, 0, 1)
	if factor < 1 then s = math.clamp(s * 1.05, 0, 1) end
	return Color3.fromHSV(h, s, v)
end

local function setAccentColor(color)
	if typeof(color) ~= "Color3" then return end
	K.white   = color
	K.logoTop = shade(color, 1.35)
	K.logoMid = color
	K.logoBot = shade(color, 0.55)
	refreshThemeUpdaters()
end

local function randomName()
	local chars = {}
	for i = 1, math.random(10, 16) do
		local r = math.random(1, 52)
		chars[i] = string.char(r <= 26 and 64 + r or 70 + r)
	end
	return table.concat(chars)
end

local function inst(cls, props, parent)
	local o = Instance.new(cls)
	for k,v in pairs(props or {}) do o[k]=v end
	if parent then o.Parent=parent end
	return o
end

local function tw(obj, goals, t, style, dir)
	return TweenService:Create(obj,
		TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
		goals)
end

local function rnd(p, r)
	return inst("UICorner",{CornerRadius=UDim.new(0,r or CORNER)},p)
end

local function pad(p,l,r,t,b)
	return inst("UIPadding",{
		PaddingLeft=UDim.new(0,l or 0), PaddingRight=UDim.new(0,r or 0),
		PaddingTop=UDim.new(0,t or 0),  PaddingBottom=UDim.new(0,b or 0),
	},p)
end

local function brd(p, col, thick, trans)
	local colorKey = "border"
	local color = col
	if typeof(col) == "string" then
		colorKey = col
		color = nil
	end
	local stroke = inst("UIStroke",{
		Color=color or K[colorKey] or K.border,
		Thickness=thick or 1,
		Transparency=trans or 0,
		ApplyStrokeMode=Enum.ApplyStrokeMode.Border,
	},p)
	if not color then
		registerThemeUpdater(function()
			stroke.Color = K[colorKey]
		end, stroke)
	end
	return stroke
end

local function frame(parent, p)
	local colorKey = p.colorKey
	local color = p.color
	if typeof(color) == "string" then
		colorKey = color
		color = nil
	end
	if not color and not colorKey and p.trans ~= 1 then
		colorKey = "surface"
	end
	local f = inst(p.class or "Frame",{
		BackgroundColor3       = color or (colorKey and K[colorKey]) or K.surface,
		BackgroundTransparency = p.trans  or 0,
		BorderSizePixel        = 0,
		Size                   = p.size   or UDim2.fromScale(1,1),
		Position               = p.pos    or UDim2.fromScale(0,0),
		AnchorPoint            = p.anchor or Vector2.zero,
		Name                   = p.name   or "Frame",
		ZIndex                 = p.z      or 1,
		ClipsDescendants       = p.clip   or false,
	}, parent)
	if colorKey then
		registerThemeUpdater(function()
			f.BackgroundColor3 = K[colorKey]
		end, f)
	end
	return f
end

local function lbl(parent, p)
	local colorKey = p.colorKey
	local color = p.color
	if typeof(color) == "string" then
		colorKey = color
		color = nil
	end
	if not color and not colorKey then
		colorKey = "text"
	end
	local l = inst("TextLabel",{
		BackgroundTransparency = 1,
		AutoLocalize           = false,
		Font                   = p.font   or Enum.Font.BuilderSansMedium,
		Text                   = p.text   or "",
		TextColor3             = color or K[colorKey] or K.text,
		TextSize               = p.size   or 14,
		TextXAlignment         = p.xa     or Enum.TextXAlignment.Left,
		TextYAlignment         = p.ya     or Enum.TextYAlignment.Center,
		TextTransparency       = p.trans  or 0,
		TextWrapped            = p.wrap   or false,
		Size                   = p.sz     or UDim2.fromScale(1,1),
		Position               = p.pos    or UDim2.fromScale(0,0),
		AnchorPoint            = p.anchor or Vector2.zero,
		Name                   = p.name   or "Lbl",
		ZIndex                 = p.z      or 2,
	}, parent)
	if colorKey then
		registerThemeUpdater(function()
			l.TextColor3 = K[colorKey]
		end, l)
	end
	return l
end

