		pLayout.SortOrder = Enum.SortOrder.LayoutOrder

		local paragraph = Instance.new("Frame", prompt)
		paragraph.AutomaticSize = Enum.AutomaticSize.Y
		paragraph.BackgroundTransparency = 1
		paragraph.Size = UDim2.new(1, 0, 0, 38)
		local paraLayout = Instance.new("UIListLayout", paragraph)
		paraLayout.Padding = UDim.new(0, 15)
		paraLayout.SortOrder = Enum.SortOrder.LayoutOrder

		local paragraphHeader = Instance.new("TextLabel", paragraph)
		paragraphHeader.FontFace = Font.new(assets.interFont, Enum.FontWeight.Medium)
		paragraphHeader.RichText = true
		paragraphHeader.Text = DialogSettings.Title or ""
		paragraphHeader.TextColor3 = Color3.fromRGB(255, 255, 255)
		paragraphHeader.TextSize = 18
		paragraphHeader.TextTransparency = 0.4
		paragraphHeader.TextWrapped = true
		paragraphHeader.AutomaticSize = Enum.AutomaticSize.Y
		paragraphHeader.BackgroundTransparency = 1
		paragraphHeader.Size = UDim2.fromScale(1, 0)

		local paragraphBody = Instance.new("TextLabel", paragraph)
		paragraphBody.FontFace = Font.new(assets.interFont)
		paragraphBody.RichText = true
		paragraphBody.Text = DialogSettings.Description or ""
		paragraphBody.TextColor3 = Color3.fromRGB(255, 255, 255)
		paragraphBody.TextSize = 14
		paragraphBody.TextTransparency = 0.5
		paragraphBody.TextWrapped = true
		paragraphBody.AutomaticSize = Enum.AutomaticSize.Y
		paragraphBody.BackgroundTransparency = 1
		paragraphBody.LayoutOrder = 1
		paragraphBody.Size = UDim2.fromScale(1, 0)

		local interactions = Instance.new("Frame", prompt)
		interactions.AutomaticSize = Enum.AutomaticSize.Y
		interactions.BackgroundTransparency = 1
		interactions.LayoutOrder = 1
		interactions.Size = UDim2.fromScale(1, 0)
		local intLayout = Instance.new("UIListLayout", interactions)
		intLayout.Padding = UDim.new(0, 10)
		intLayout.SortOrder = Enum.SortOrder.LayoutOrder
		Instance.new("UIPadding", interactions).PaddingTop = UDim.new(0, 20)

		local canvasIn = Tween(dialogCanvas, TweenInfo.new(0.1, Enum.EasingStyle.Sine), { GroupTransparency = 0 })
		local canvasOut = Tween(dialogCanvas, TweenInfo.new(0.1, Enum.EasingStyle.Sine), { GroupTransparency = 1 })
		local scaleIn = Tween(promptUIScale, TweenInfo.new(0.1, Enum.EasingStyle.Sine), { Scale = 1 })
		local scaleOut = Tween(promptUIScale, TweenInfo.new(0.1, Enum.EasingStyle.Sine), { Scale = 0.95 })

		local function dialogOut()
			if not dialogCanvas.Parent then return end
			canvasOut:Play()
			scaleOut:Play()
			canvasOut.Completed:Wait()
			dialogCanvas:Destroy()
		end

		for _, btnCfg in pairs(DialogSettings.Buttons or {}) do
			local b = Instance.new("TextButton", interactions)
			b.FontFace = Font.new(assets.interFont)
			b.Text = btnCfg.Name or "Button"
			b.TextColor3 = Color3.fromRGB(255, 255, 255)
			b.TextSize = 15
			b.TextTransparency = 0.5
			b.TextTruncate = Enum.TextTruncate.AtEnd
			b.AutoButtonColor = false
			b.AutomaticSize = Enum.AutomaticSize.Y
			b.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
			b.Size = UDim2.fromScale(1, 0)
			Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)
			local bPad = Instance.new("UIPadding", b)
			bPad.PaddingTop = UDim.new(0, 9)
			bPad.PaddingBottom = UDim.new(0, 9)
			bPad.PaddingLeft = UDim.new(0, 10)
			bPad.PaddingRight = UDim.new(0, 10)

			b.MouseEnter:Connect(function()
				Tween(b, TweenInfo.new(0.2, Enum.EasingStyle.Sine), { BackgroundTransparency = 0.3, TextTransparency = 0.6 }):Play()
			end)
			b.MouseLeave:Connect(function()
				Tween(b, TweenInfo.new(0.2, Enum.EasingStyle.Sine), { BackgroundTransparency = 0, TextTransparency = 0.5 }):Play()
			end)
			b.MouseButton1Click:Connect(function()
				if dialogCanvas.GroupTransparency ~= 0 then return end
				if btnCfg.Callback then pcall(btnCfg.Callback) end
				dialogOut()
			end)
		end

		canvasIn:Play()
		scaleIn:Play()

		function DialogFunctions:UpdateTitle(New) paragraphHeader.Text = New end
		function DialogFunctions:UpdateDescription(New) paragraphBody.Text = New end
		function DialogFunctions:Cancel() dialogOut() end

		return DialogFunctions
	end

