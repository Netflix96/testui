				--// VantixUI Toggle
				function SecFuncs:Toggle(ElementSettings, Flag)
					ElementSettings = ElementSettings or {}
					local descText = ElementSettings.Description or ElementSettings.Desc or ""
					local initialLock = ElementSettings.Locked
						and (typeof(ElementSettings.Locked) == "string" and ElementSettings.Locked or DEFAULT_LOCK_REASON)
						or nil

					local ToggleFunctions = {
						Settings = ElementSettings,
						IgnoreConfig = false,
						Class = "Toggle",
						State = (not initialLock) and (ElementSettings.Default == true) or false,
					}

					local built = makeVantixRow(secCard, {
						Title = ElementSettings.Name or "Toggle",
						Description = descText,
						Risky = ElementSettings.Risky,
