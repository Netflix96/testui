		local pPad = Instance.new("UIPadding", prompt)
		pPad.PaddingTop = UDim.new(0, 20)
		pPad.PaddingBottom = UDim.new(0, 20)
		pPad.PaddingLeft = UDim.new(0, 20)
		pPad.PaddingRight = UDim.new(0, 20)
