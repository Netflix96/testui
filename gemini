					local function CalculateDropdownSize()
						local totalHeight = 0
						local visibleChildrenCount = 0
						local padding = dropdownFrameUIPadding.PaddingTop.Offset + dropdownFrameUIPadding.PaddingBottom.Offset
						for _, child in pairs(dropdownFrame:GetChildren()) do
							if not child:IsA("UIComponent") and child.Visible then
								totalHeight += child.AbsoluteSize.Y
								visibleChildrenCount += 1
							end
						end
						local spacing = dropdownFrameUIListLayout.Padding.Offset * math.max(0, visibleChildrenCount - 1)
						return math.max(38, totalHeight + spacing + padding)
					end

					searchBox:GetPropertyChangedSignal("Text"):Connect(function()
						local term = searchBox.Text:lower()
						for _, optObj in pairs(OptionObjs) do
							optObj.Button.Visible = string.find(optObj.NameLabel.Text:lower(), term) ~= nil
						end
						dropdown.Size = UDim2.new(1, 0, 0, CalculateDropdownSize())
					end)

					local function syncValue()
						if isMulti then
							local map = {}
							for _, v in ipairs(Selected) do map[v] = true end
							DropdownFunctions.Value = map
						else
							DropdownFunctions.Value = Selected[1]
						end
						refreshHeaderText()
					end

					local function setOptionState(optionName, state)
						local optObj = OptionObjs[optionName]
						if not optObj then return end
						if state then
							if isMulti then
								if not table.find(Selected, optionName) then
									table.insert(Selected, optionName)
								end
							else
								for otherName, otherObj in pairs(OptionObjs) do
									if otherName ~= optionName then
										otherObj.Checkmark.TextTransparency = 1
										otherObj.NameLabel.TextTransparency = 0.5
									end
								end
								Selected = { optionName }
							end
							optObj.Checkmark.TextTransparency = 0
							optObj.NameLabel.TextTransparency = 0.2
						else
							if isMulti then
								local idx = table.find(Selected, optionName)
								if idx then table.remove(Selected, idx) end
							elseif Selected[1] == optionName then
								Selected = {}
							end
							optObj.Checkmark.TextTransparency = 1
							optObj.NameLabel.TextTransparency = 0.5
						end
						syncValue()
					end

					local dropped = false
					local db = false
					interact.MouseButton1Click:Connect(function()
						if db then return end
						db = true
						dropped = not dropped
						local targetSize = dropped and UDim2.new(1, 0, 0, CalculateDropdownSize()) or UDim2.new(1, 0, 0, 38)
						local dropTween = Tween(dropdown, TweenInfo.new(0.2, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), { Size = targetSize })
						Tween(dropdownImage, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Rotation = dropped and -90 or 0 }):Play()
						if dropped then dropdownFrame.Visible = true end
						dropTween:Play()
						dropTween.Completed:Connect(function()
							if not dropped then dropdownFrame.Visible = false end
							db = false
						end)
					end)

					local function addOption(idx, optName)
						if OptionObjs[optName] then return end
						local optBtn = Instance.new("TextButton")
						optBtn.Name = "Option"
						optBtn.Text = ""
						optBtn.BackgroundTransparency = 1
						optBtn.Size = UDim2.new(1, 0, 0, 30)
						optBtn.Parent = dropdownFrame
						Instance.new("UIPadding", optBtn).PaddingLeft = UDim.new(0, 15)

						local optRowLayout = Instance.new("UIListLayout", optBtn)
						optRowLayout.Padding = UDim.new(0, 10)
						optRowLayout.FillDirection = Enum.FillDirection.Horizontal
						optRowLayout.SortOrder = Enum.SortOrder.LayoutOrder
						optRowLayout.VerticalAlignment = Enum.VerticalAlignment.Center

						local checkmark = Instance.new("TextLabel", optBtn)
						checkmark.Name = "Checkmark"
						checkmark.FontFace = Font.new(assets.interFont)
						checkmark.Text = "✓"
						checkmark.TextColor3 = Color3.fromRGB(255, 255, 255)
						checkmark.TextSize = 13
						checkmark.TextTransparency = 1
						checkmark.BackgroundTransparency = 1
						checkmark.LayoutOrder = -1
						checkmark.Size = UDim2.fromOffset(12, 16)

						local optLbl = Instance.new("TextLabel", optBtn)
						optLbl.Name = "OptionName"
						optLbl.FontFace = Font.new(assets.interFont)
						optLbl.Text = optName
						optLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
						optLbl.TextSize = 13
						optLbl.TextTransparency = 0.5
						optLbl.TextTruncate = Enum.TextTruncate.AtEnd
						optLbl.TextXAlignment = Enum.TextXAlignment.Left
						optLbl.AutomaticSize = Enum.AutomaticSize.Y
						optLbl.BackgroundTransparency = 1
						optLbl.Size = UDim2.new(1, -24, 0, 0)

						OptionObjs[optName] = { Index = idx, Button = optBtn, NameLabel = optLbl, Checkmark = checkmark }

						local def = ElementSettings.Default
						local isDef = false
						if isMulti then
							if type(def) == "table" then
								isDef = table.find(def, optName) ~= nil or def[optName] == true
							elseif type(def) == "string" then
								isDef = def == optName
							end
						else
							isDef = (type(def) == "number" and def == idx) or (type(def) == "string" and def == optName)
						end
						if isDef then setOptionState(optName, true) end

						optBtn.MouseButton1Click:Connect(function()
							local currentlySelected = table.find(Selected, optName) ~= nil
							local nextState = not currentlySelected
							if ElementSettings.Required and not nextState and #Selected <= 1 then
								return
							end
							setOptionState(optName, nextState)
							if ElementSettings.Callback then
								pcall(ElementSettings.Callback, DropdownFunctions.Value)
							end
						end)
					end

					for i, v in ipairs(currentOptions) do addOption(i, v) end
					refreshHeaderText()

					function DropdownFunctions:UpdateName(New) dropdownName.Text = New end
					function DropdownFunctions:SetVisibility(State) dropdown.Visible = State end
					function DropdownFunctions:UpdateSelection(newSelection, silent)
						for optName in pairs(OptionObjs) do setOptionState(optName, false) end
						if type(newSelection) == "number" then
							for optName, data in pairs(OptionObjs) do
								if data.Index == newSelection then setOptionState(optName, true) end
							end
						elseif type(newSelection) == "string" then
							setOptionState(newSelection, true)
						elseif type(newSelection) == "table" then
							for k, v in pairs(newSelection) do
								if type(k) == "number" and type(v) == "string" then
									setOptionState(v, true)
								elseif type(k) == "string" and v then
									setOptionState(k, true)
								end
							end
						end
						if not silent and ElementSettings.Callback then
							pcall(ElementSettings.Callback, DropdownFunctions.Value)
						end
					end
					function DropdownFunctions:Set(val, silent) DropdownFunctions:UpdateSelection(val, silent) end
					function DropdownFunctions:Get() return DropdownFunctions.Value end
					function DropdownFunctions:InsertOptions(newOptions)
						if type(newOptions) ~= "table" then return end
						for _, v in ipairs(newOptions) do
							if not table.find(currentOptions, v) then table.insert(currentOptions, v) end
							addOption(#currentOptions, v)
						end
						if dropped then dropdown.Size = UDim2.new(1, 0, 0, CalculateDropdownSize()) end
					end
					function DropdownFunctions:ClearOptions()
						for _, optObj in pairs(OptionObjs) do optObj.Button:Destroy() end
						OptionObjs = {}
						Selected = {}
						currentOptions = {}
						syncValue()
						if dropped then dropdown.Size = UDim2.new(1, 0, 0, CalculateDropdownSize()) end
					end
					function DropdownFunctions:SetOptions(newOptions)
						DropdownFunctions:ClearOptions()
						DropdownFunctions:InsertOptions(newOptions)
					end
					function DropdownFunctions:GetOptions()
						local status = {}
						for optName in pairs(OptionObjs) do status[optName] = table.find(Selected, optName) ~= nil end
						return status
					end
					function DropdownFunctions:RemoveOptions(removeList)
						if type(removeList) ~= "table" then return end
						for _, optName in ipairs(removeList) do
							local idx = table.find(Selected, optName)
							if idx then table.remove(Selected, idx) end
							local listIdx = table.find(currentOptions, optName)
							if listIdx then table.remove(currentOptions, listIdx) end
							if OptionObjs[optName] then
								OptionObjs[optName].Button:Destroy()
								OptionObjs[optName] = nil
							end
						end
						syncValue()
						if dropped then dropdown.Size = UDim2.new(1, 0, 0, CalculateDropdownSize()) end
					end
					function DropdownFunctions:IsOption(optName) return OptionObjs[optName] ~= nil end

					if Flag then MacLib.Options[Flag] = DropdownFunctions end
					return DropdownFunctions
				end

