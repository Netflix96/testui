	local function selectVantixTab(tabObj)
		if activeTab == tabObj then return end
		activeTab = tabObj
		for _, t in ipairs(allTabs) do
			local sel = (t == tabObj)
			t.Page.Visible = sel
			twVantix(t.Btn, { BackgroundColor3 = sel and K.raised or K.bg }, 0.14):Play()
			twVantix(t.Stroke, { Color = sel and K.borderHi or K.border, Transparency = sel and 0.1 or 0.6 }, 0.14):Play()
			twVantix(t.Label, { TextColor3 = sel and K.text or K.muted }, 0.14):Play()
			if t.Icon then
				twVantix(t.Icon, { ImageColor3 = sel and K.text or K.muted }, 0.14):Play()
			end
		end
	end

