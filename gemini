					ibStroke.Color = Color3.fromRGB(255, 255, 255)
					ibStroke.Transparency = 0.9
					local ibPad = Instance.new("UIPadding", inputBox)
					ibPad.PaddingLeft = UDim.new(0, 5)
					ibPad.PaddingRight = UDim.new(0, 5)
					local constraint = Instance.new("UISizeConstraint", inputBox)

					local function applyCharacterLimit(value)
						if ElementSettings.CharacterLimit then
							return value:sub(1, ElementSettings.CharacterLimit)
						end
						return value
					end

					local CharacterSubs = {
						All = function(value) return applyCharacterLimit(value) end,
						Numeric = function(value)
							local cleaned = value:match("^%-?%d*$") and value or value:gsub("[^%d-]", ""):gsub("(%-)", function(m, pos) return pos == 1 and m or "" end)
							return applyCharacterLimit(cleaned)
						end,
						Alphabetic = function(value) return applyCharacterLimit(value:gsub("[^a-zA-Z ]", "")) end,
						AlphaNumeric = function(value) return applyCharacterLimit(value:gsub("[^a-zA-Z0-9]", "")) end,
					}
					local filterFn = type(ElementSettings.AcceptedCharacters) == "function"
						and ElementSettings.AcceptedCharacters
						or (CharacterSubs[ElementSettings.AcceptedCharacters] or CharacterSubs.All)

					local function checkSize()
						local scaleFactor = math.max(0.1, baseUIScale.Scale)
						constraint.MaxSize = Vector2.new(math.max(40, (input.AbsoluteSize.X - inputName.AbsoluteSize.X - 20) / scaleFactor), 9e9)
					end
					checkSize()
					inputName:GetPropertyChangedSignal("AbsoluteSize"):Connect(checkSize)

					inputBox:GetPropertyChangedSignal("Text"):Connect(function()
						local filtered = filterFn(inputBox.Text)
						if inputBox.Text ~= filtered then
							inputBox.Text = filtered
						end
						InputFunctions.Text = filtered
						if ElementSettings.onChanged then
							pcall(ElementSettings.onChanged, filtered)
						end
					end)

					inputBox.FocusLost:Connect(function(enterPressed)
						local filtered = filterFn(inputBox.Text)
						inputBox.Text = filtered
						InputFunctions.Text = filtered
						if ElementSettings.Callback then
							pcall(ElementSettings.Callback, filtered, enterPressed)
						end
					end)

					function InputFunctions:UpdateName(Name) inputName.Text = Name end
					function InputFunctions:SetVisibility(State) input.Visible = State end
					function InputFunctions:GetInput() return InputFunctions.Text end
					function InputFunctions:Get() return InputFunctions.Text end
					function InputFunctions:UpdatePlaceholder(Placeholder) inputBox.PlaceholderText = Placeholder end
					function InputFunctions:UpdateText(Text, silent)
						local filtered = filterFn(tostring(Text or ""))
						inputBox.Text = filtered
						InputFunctions.Text = filtered
						if not silent and ElementSettings.Callback then
							pcall(ElementSettings.Callback, filtered, false)
						end
					end
					function InputFunctions:Set(Text, silent) InputFunctions:UpdateText(Text, silent) end

					if Flag then MacLib.Options[Flag] = InputFunctions end
					return InputFunctions
				end

