local function isMobileViewport()
	local vp = Camera.ViewportSize
	return (UserInputService.TouchEnabled and not UserInputService.MouseEnabled) or vp.X < 680 or vp.Y < 500
end

local function GetGui()
	local gui = Instance.new("ScreenGui")
	gui.Name = "MacLibVantix_" .. HttpService:GenerateGUID(false):sub(1, 8)
	gui.ScreenInsets = Enum.ScreenInsets.None
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 2147483647

	local parent
	if RunService:IsStudio() then
		parent = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	elseif typeof(gethui) == "function" then
		pcall(function() parent = gethui() end)
	end
	if not parent then
		pcall(function()
			parent = cloneref and cloneref(MacLib.GetService("CoreGui")) or MacLib.GetService("CoreGui")
		end)
	end
	gui.Parent = parent or LocalPlayer:FindFirstChildOfClass("PlayerGui")
	return gui
end

local function Tween(instance, info, props)
	return TweenService:Create(instance, info, props)
end

local function addCorner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 8)
	c.Parent = parent
	return c
end

local function addStroke(parent, color, transparency, thickness)
	local s = Instance.new("UIStroke")
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Color = color or Palette.accent
	s.Transparency = transparency ~= nil and transparency or 0.9
	s.Thickness = thickness or 1
	s.Parent = parent
	return s
end

local function addPadding(parent, l, r, t, b)
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, l or 0)
	p.PaddingRight = UDim.new(0, r or 0)
	p.PaddingTop = UDim.new(0, t or 0)
	p.PaddingBottom = UDim.new(0, b or 0)
	p.Parent = parent
	return p
end

