		local function finish(accepted)
			if closed then return end
			closed = true
			modalOpen = false

			Tween(backdrop, TweenInfo.new(0.14, Enum.EasingStyle.Sine), { BackgroundTransparency = 1 }):Play()
			Tween(card, TweenInfo.new(0.14, Enum.EasingStyle.Sine), { GroupTransparency = 1 }):Play()
			local outScale = Tween(scale, TweenInfo.new(0.14, Enum.EasingStyle.Sine), { Scale = 0.92 })
			outScale:Play()
			outScale.Completed:Connect(function()
				backdrop:Destroy()
			end)

			if accepted then
				if isRisky then
					riskyConfirmedSession = true
				else
					betaConfirmedSession = true
				end
				if onConfirm then onConfirm() end
			elseif onCancel then
				onCancel()
			end

			local nextModal = table.remove(modalQueue, 1)
			if nextModal then
				task.defer(showConfirmModal, nextModal[1], nextModal[2], nextModal[3], nextModal[4])
			end
		end

		cancelBtn.MouseButton1Click:Connect(function() finish(false) end)
		confirmBtn.MouseButton1Click:Connect(function() finish(true) end)
		backdrop.MouseButton1Click:Connect(function() finish(false) end)

		Tween(backdrop, TweenInfo.new(0.16, Enum.EasingStyle.Sine), { BackgroundTransparency = 0.5 }):Play()
		Tween(card, TweenInfo.new(0.16, Enum.EasingStyle.Quint), { GroupTransparency = 0 }):Play()
		Tween(scale, TweenInfo.new(0.2, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end

