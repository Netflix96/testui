					local btnText = opts.ButtonText or opts.Text or "Run"
					local textBounds = TextService:GetTextSize(btnText, 12, Enum.Font.GothamMedium, Vector2.new(140, 28))
					local btnW = math.clamp(textBounds.X + 20, 62, 120)

					local actionBtn = Instance.new("TextButton")
					actionBtn.AnchorPoint = Vector2.new(1, 0.5)
					actionBtn.Position = UDim2.new(1, -10, 0.5, 0)
					actionBtn.Size = UDim2.fromOffset(btnW, 26)
					actionBtn.BackgroundColor3 = Palette.bg
					actionBtn.FontFace = Font.new(assets.interFont, Enum.FontWeight.Medium)
					actionBtn.Text = btnText
					actionBtn.TextColor3 = Palette.text
					actionBtn.TextSize = 12
					actionBtn.TextTruncate = Enum.TextTruncate.AtEnd
					actionBtn.AutoButtonColor = false
					actionBtn.ZIndex = 18
					actionBtn.Parent = row
					addCorner(actionBtn, 6)
					addStroke(actionBtn, Palette.borderHi, 0.3, 1)

					local flagWidth = attachFlagTag(row, opts, btnW + 2)
					local titleTint = opts.Risky and RISKY_COLOR or (opts.Beta and BETA_COLOR or Palette.text)
					createRowLabelBlock(row, opts.Name or opts.Title or "Button", opts.Subtitle, btnW + flagWidth + 10, titleTint)

					local function execute()
						Tween(actionBtn, TweenInfo.new(0.08), { BackgroundColor3 = Palette.accent, TextColor3 = Palette.accentInv }):Play()
						task.delay(0.14, function()
							if actionBtn.Parent then
								Tween(actionBtn, TweenInfo.new(0.12), { BackgroundColor3 = Palette.bg, TextColor3 = Palette.text }):Play()
							end
						end)
						if opts.Callback then
							task.spawn(opts.Callback)
						end
					end

					actionBtn.MouseButton1Click:Connect(function()
						guardAction(opts, execute)
					end)

					local handle = {
						UpdateName = function(_, newName)
							local lbl = row:FindFirstChild("LabelBlock") and row.LabelBlock:FindFirstChild("Title")
							if lbl then lbl.Text = tostring(newName) end
						end,
					}
					if flag then MacLib.Options[flag] = handle end
					return handle
				end

				-- Vantix Toggle Control
				function SectionAPI:Toggle(opts, flag)
					opts = opts or {}
					local hasSub = opts.Subtitle and opts.Subtitle ~= ""
					local row = Instance.new("Frame")
					row.Name = "VantixToggle"
					row.Size = UDim2.new(1, 0, 0, hasSub and 50 or 38)
					row.BackgroundColor3 = Palette.raised
					row.BorderSizePixel = 0
					row.LayoutOrder = nextOrder()
					row.ZIndex = 14
					row.Parent = sectionFrame
					addCorner(row, 7)
					addStroke(row, Palette.border, 0.35, 1)

					local trackW, trackH, knobSz = 44, 24, 18
					local track = Instance.new("Frame")
					track.AnchorPoint = Vector2.new(1, 0.5)
					track.Position = UDim2.new(1, -10, 0.5, 0)
					track.Size = UDim2.fromOffset(trackW, trackH)
					track.BackgroundColor3 = Palette.bg
					track.BorderSizePixel = 0
					track.ZIndex = 18
					track.Parent = row
					addCorner(track, 99)
					local trackStroke = addStroke(track, Palette.borderHi, 0.25, 1)

					local knob = Instance.new("Frame")
					knob.AnchorPoint = Vector2.new(0, 0.5)
					knob.Position = UDim2.new(0, 3, 0.5, 0)
					knob.Size = UDim2.fromOffset(knobSz, knobSz)
					knob.BackgroundColor3 = Palette.text
					knob.BorderSizePixel = 0
					knob.ZIndex = 19
					knob.Parent = track
					addCorner(knob, 99)

					local hitBtn = Instance.new("TextButton")
					hitBtn.Size = UDim2.fromScale(1, 1)
					hitBtn.BackgroundTransparency = 1
					hitBtn.Text = ""
					hitBtn.AutoButtonColor = false
					hitBtn.ZIndex = 20
					hitBtn.Parent = track

					local flagWidth = attachFlagTag(row, opts, trackW + 2)
					local titleTint = opts.Risky and RISKY_COLOR or (opts.Beta and BETA_COLOR or Palette.text)
					createRowLabelBlock(row, opts.Name or opts.Title or "Toggle", opts.Subtitle, trackW + flagWidth + 10, titleTint)

					local state = opts.Default == true
					local function render(animate)
						local targetX = state and (trackW - knobSz - 3) or 3
						local targetTrackColor = state and Palette.accent or Palette.bg
						local targetKnobColor = state and Palette.accentInv or Palette.text
						if animate then
							Tween(knob, TweenInfo.new(0.16, Enum.EasingStyle.Quint), { Position = UDim2.new(0, targetX, 0.5, 0), BackgroundColor3 = targetKnobColor }):Play()
							Tween(track, TweenInfo.new(0.16, Enum.EasingStyle.Quint), { BackgroundColor3 = targetTrackColor }):Play()
						else
							knob.Position = UDim2.new(0, targetX, 0.5, 0)
							knob.BackgroundColor3 = targetKnobColor
							track.BackgroundColor3 = targetTrackColor
						end
						trackStroke.Transparency = state and 1 or 0.25
					end

					local function setState(newVal, fireCb)
						state = (newVal == true)
						render(true)
						if fireCb and opts.Callback then
							task.spawn(opts.Callback, state)
						end
					end

					render(false)

					hitBtn.MouseButton1Click:Connect(function()
						local nextVal = not state
						if nextVal then
							guardAction(opts, function()
								setState(true, true)
							end)
						else
							setState(false, true)
						end
					end)

					local handle = {
						State = state,
						GetState = function() return state end,
						UpdateState = function(_, v) setState(v, true) end,
						Set = function(_, v) setState(v, true) end,
					}
					table.insert(activeToggles, handle)
					if flag then MacLib.Options[flag] = handle end
					return handle
				end

				-- Vantix Slider Control
				function SectionAPI:Slider(opts, flag)
					opts = opts or {}
					local minVal = opts.Minimum or opts.Min or 0
					local maxVal = opts.Maximum or opts.Max or 100
					if maxVal <= minVal then maxVal = minVal + 1 end
					local currentVal = math.clamp(opts.Default or minVal, minVal, maxVal)

					local row = Instance.new("Frame")
					row.Name = "VantixSlider"
					row.Size = UDim2.new(1, 0, 0, 56)
					row.BackgroundColor3 = Palette.raised
					row.BorderSizePixel = 0
					row.LayoutOrder = nextOrder()
					row.ZIndex = 14
					row.Parent = sectionFrame
					addCorner(row, 7)
					addStroke(row, Palette.border, 0.35, 1)

					local valBadgeW = 54
					local flagWidth = attachFlagTag(row, opts, valBadgeW + 2)
					local titleTint = opts.Risky and RISKY_COLOR or (opts.Beta and BETA_COLOR or Palette.text)
					local titleLbl = createRowLabelBlock(row, opts.Name or opts.Title or "Slider", nil, valBadgeW + flagWidth + 10, titleTint)
					titleLbl.Position = UDim2.fromOffset(0, 8)

					local valLbl = Instance.new("TextLabel")
					valLbl.AnchorPoint = Vector2.new(1, 0)
					valLbl.Position = UDim2.new(1, -10, 0, 8)
					valLbl.Size = UDim2.fromOffset(valBadgeW, 18)
					valLbl.BackgroundTransparency = 1
					valLbl.FontFace = Font.new(assets.interFont, Enum.FontWeight.Bold)
					valLbl.Text = tostring(math.round(currentVal))
					valLbl.TextColor3 = Palette.text
					valLbl.TextSize = 12
					valLbl.TextXAlignment = Enum.TextXAlignment.Right
					valLbl.ZIndex = 18
					valLbl.Parent = row

					local knobSz = 16
					local sliderTouchArea = Instance.new("TextButton")
					sliderTouchArea.Position = UDim2.new(0, 10, 0, 30)
					sliderTouchArea.Size = UDim2.new(1, -20, 0, 22)
					sliderTouchArea.BackgroundTransparency = 1
					sliderTouchArea.Text = ""
					sliderTouchArea.AutoButtonColor = false
					sliderTouchArea.ZIndex = 19
					sliderTouchArea.Parent = row

					local bar = Instance.new("Frame")
					bar.AnchorPoint = Vector2.new(0, 0.5)
					bar.Position = UDim2.new(0, knobSz / 2, 0.5, 0)
					bar.Size = UDim2.new(1, -knobSz, 0, 5)
					bar.BackgroundColor3 = Palette.borderHi
					bar.BorderSizePixel = 0
					bar.ZIndex = 16
					bar.Parent = sliderTouchArea
					addCorner(bar, 99)

					local fill = Instance.new("Frame")
					fill.Size = UDim2.new(0, 0, 1, 0)
					fill.BackgroundColor3 = Palette.accent
					fill.BorderSizePixel = 0
					fill.ZIndex = 17
					fill.Parent = bar
					addCorner(fill, 99)

					local knob = Instance.new("Frame")
					knob.AnchorPoint = Vector2.new(0.5, 0.5)
					knob.Position = UDim2.new(0, 0, 0.5, 0)
					knob.Size = UDim2.fromOffset(knobSz, knobSz)
					knob.BackgroundColor3 = Palette.accent
					knob.BorderSizePixel = 0
					knob.ZIndex = 18
					knob.Parent = bar
					addCorner(knob, 99)

					local function setValue(v, fireCb)
						currentVal = math.clamp(v, minVal, maxVal)
						local pct = (currentVal - minVal) / (maxVal - minVal)
						fill.Size = UDim2.new(pct, 0, 1, 0)
						knob.Position = UDim2.new(pct, 0, 0.5, 0)
						local prec = opts.Precision or 0
						valLbl.Text = prec > 0 and string.format("%." .. prec .. "f", currentVal) or tostring(math.round(currentVal))
						if fireCb and opts.Callback then
							task.spawn(opts.Callback, currentVal)
						end
					end

					task.defer(function() setValue(currentVal, false) end)

					local sliding = false
					local function updateFromInput(inp)
						local absX = bar.AbsolutePosition.X
						local absW = math.max(1, bar.AbsoluteSize.X)
						local pct = math.clamp((inp.Position.X - absX) / absW, 0, 1)
						setValue(minVal + pct * (maxVal - minVal), true)
					end

					sliderTouchArea.InputBegan:Connect(function(inp)
						if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
							sliding = true
							updateFromInput(inp)
						end
					end)
					track(UserInputService.InputChanged, function(inp)
						if sliding and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
							updateFromInput(inp)
						end
					end)
					track(UserInputService.InputEnded, function(inp)
						if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
							sliding = false
						end
					end)

					local handle = {
						GetValue = function() return currentVal end,
						Set = function(_, v) setValue(v, true) end,
						UpdateValue = function(_, v) setValue(tonumber(v) or minVal, true) end,
					}
					if flag then MacLib.Options[flag] = handle end
					return handle
				end

				-- Vantix TextBox / Input Control
				function SectionAPI:Input(opts, flag)
					opts = opts or {}
					local hasSub = opts.Subtitle and opts.Subtitle ~= ""
					local row = Instance.new("Frame")
					row.Name = "VantixTextBox"
					row.Size = UDim2.new(1, 0, 0, hasSub and 50 or 38)
					row.BackgroundColor3 = Palette.raised
					row.BorderSizePixel = 0
					row.LayoutOrder = nextOrder()
					row.ZIndex = 14
					row.Parent = sectionFrame
					addCorner(row, 7)
					addStroke(row, Palette.border, 0.35, 1)

					local boxW = mobile and 106 or 140
					local box = Instance.new("TextBox")
					box.AnchorPoint = Vector2.new(1, 0.5)
					box.Position = UDim2.new(1, -10, 0.5, 0)
					box.Size = UDim2.fromOffset(boxW, 28)
					box.BackgroundColor3 = Palette.bg
					box.BorderSizePixel = 0
					box.ClearTextOnFocus = false
					box.FontFace = Font.new(assets.interFont, Enum.FontWeight.Medium)
					box.Text = opts.Default or ""
					box.PlaceholderText = opts.Placeholder or "Type here..."
					box.PlaceholderColor3 = Palette.muted
					box.TextColor3 = Palette.text
					box.TextSize = 12
					box.TextTruncate = Enum.TextTruncate.AtEnd
					box.TextXAlignment = Enum.TextXAlignment.Left
					box.ZIndex = 18
					box.Parent = row
					addCorner(box, 6)
					local boxStroke = addStroke(box, Palette.borderHi, 0.3, 1)
					addPadding(box, 8, 8, 0, 0)

					local flagWidth = attachFlagTag(row, opts, boxW + 2)
					local titleTint = opts.Risky and RISKY_COLOR or (opts.Beta and BETA_COLOR or Palette.text)
					createRowLabelBlock(row, opts.Name or opts.Title or "Input", opts.Subtitle, boxW + flagWidth + 10, titleTint)

					box.Focused:Connect(function()
						Tween(boxStroke, TweenInfo.new(0.12), { Color = Palette.accent, Transparency = 0.15 }):Play()
					end)
					box.FocusLost:Connect(function(enterPressed)
						Tween(boxStroke, TweenInfo.new(0.12), { Color = Palette.borderHi, Transparency = 0.3 }):Play()
						if opts.Callback then
							task.spawn(opts.Callback, box.Text, enterPressed)
						end
					end)

					local handle = {
						GetInput = function() return box.Text end,
						Set = function(_, txt) box.Text = tostring(txt or "") end,
						UpdateText = function(_, txt) box.Text = tostring(txt or "") end,
					}
					if flag then MacLib.Options[flag] = handle end
					return handle
				end

				function SectionAPI:Label(opts)
					opts = typeof(opts) == "table" and opts or { Text = tostring(opts or "") }
					local lbl = Instance.new("TextLabel")
					lbl.Size = UDim2.new(1, 0, 0, 0)
					lbl.AutomaticSize = Enum.AutomaticSize.Y
					lbl.BackgroundTransparency = 1
					lbl.FontFace = Font.new(assets.interFont, Enum.FontWeight.Regular)
					lbl.Text = opts.Text or opts.Name or ""
					lbl.TextColor3 = Palette.sub
					lbl.TextSize = 12
					lbl.TextWrapped = true
					lbl.TextXAlignment = Enum.TextXAlignment.Left
					lbl.LayoutOrder = nextOrder()
					lbl.Parent = sectionFrame
					return {
						UpdateName = function(_, t) lbl.Text = tostring(t) end,
					}
				end

				return SectionAPI
			end

			return TabAPI
		end

		return GroupAPI
	end

	-- Keep window responsive on viewport resize
	track(Camera:GetPropertyChangedSignal("ViewportSize"), function()
		local newVp = Camera.ViewportSize
		baseSizeConstraint.MaxSize = Vector2.new(math.max(300, newVp.X - 16), math.max(240, newVp.Y - 16))
		local m = isMobileViewport()
		local sw = m and math.clamp(math.floor(base.AbsoluteSize.X * 0.31), 112, 165) or math.clamp(math.floor(base.AbsoluteSize.X * 0.28), 150, 230)
		sidebar.Size = UDim2.new(0, sw, 1, 0)
		content.Size = UDim2.new(1, -sw, 1, 0)
	end)

	gui.Destroying:Connect(cleanup)

	return WindowFunctions
end

return MacLib
