		pLbl.Size = UDim2.new(0, 0, 1, 0)
		pLbl.AutomaticSize = Enum.AutomaticSize.X
		pLbl.Parent = pill

		local function setLockedState(on, reason)
			lockReason = on and (typeof(reason) == "string" and reason or DEFAULT_LOCK_REASON) or nil
			pill.Visible = on
			local fade = on and 0.55 or 0
			for _, desc in ipairs(rowFrame:GetDescendants()) do
				if desc:IsA("TextLabel") and desc ~= pLbl then
					desc.TextTransparency = math.max(desc.TextTransparency, fade)
				elseif desc:IsA("ImageLabel") then
					desc.ImageTransparency = math.max(desc.ImageTransparency, fade)
				end
			end
			if controlObj and controlObj:IsA("GuiObject") then
				controlObj.Active = not on
			end
		end

		if lockReason then
			setLockedState(true, lockReason)
		end

		return {
			SetLocked = setLockedState,
			GetReason = function() return lockReason end,
		}
	end

