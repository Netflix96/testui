					togglerHead.Parent = toggle1

					local lockCtrl = attachLockBadge(toggle, toggle1, initialLock)

					local function renderToggle(state, silent)
						ToggleFunctions.State = state == true
						Tween(toggle1, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
							ImageTransparency = ToggleFunctions.State and 0 or 0.5
						}):Play()
						Tween(togglerHead, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
							ImageTransparency = ToggleFunctions.State and 0 or 0.85,
							Position = ToggleFunctions.State and UDim2.new(1, 0, 0.5, 0) or UDim2.new(0.5, 0, 0.5, 0)
						}):Play()
						if not silent and ElementSettings.Callback then
							pcall(ElementSettings.Callback, ToggleFunctions.State)
						end
					end

					renderToggle(ToggleFunctions.State, true)

					local function commitState(newState, silent)
						if newState and lockCtrl.GetReason() then
							showLockedNotice(lockCtrl.GetReason())
							return
						end
						renderToggle(newState, silent)
					end

					local function requestToggle()
						local targetState = not ToggleFunctions.State
						if lockCtrl.GetReason() then
							showLockedNotice(lockCtrl.GetReason())
							return
						end
						if targetState and ElementSettings.Risky then
							showRiskyConfirm(
								function() commitState(true, false) end,
								nil,
								typeof(ElementSettings.Risky) == "string" and ElementSettings.Risky or nil
							)
						elseif targetState and ElementSettings.Beta then
							showBetaConfirm(
								function() commitState(true, false) end,
								nil,
								typeof(ElementSettings.Beta) == "string" and ElementSettings.Beta or nil
							)
						else
							commitState(targetState, false)
						end
					end

					toggle1.MouseButton1Click:Connect(requestToggle)

					function ToggleFunctions:Toggle() requestToggle() end
					function ToggleFunctions:UpdateState(State, silent)
						if State and lockCtrl.GetReason() then return end
						commitState(State == true, silent)
					end
					function ToggleFunctions:Set(State, silent) ToggleFunctions:UpdateState(State, silent) end
					function ToggleFunctions:GetState() return ToggleFunctions.State end
					function ToggleFunctions:Get() return ToggleFunctions.State end
					function ToggleFunctions:UpdateName(Name) toggleName.Text = Name end
					function ToggleFunctions:SetVisibility(State) toggle.Visible = State end
					function ToggleFunctions:Lock(reason)
						if ToggleFunctions.State then
							commitState(false, false)
						end
						lockCtrl.SetLocked(true, reason)
					end
					function ToggleFunctions:Unlock() lockCtrl.SetLocked(false) end
					function ToggleFunctions:IsLocked() return lockCtrl.GetReason() ~= nil end

					table.insert(allToggles, ToggleFunctions)
					if Flag then MacLib.Options[Flag] = ToggleFunctions end
					return ToggleFunctions
				end

				--// VantixUI-powered Slider (clamped drag/input, rounded precision, guard support)
				function SecFuncs:Slider(ElementSettings, Flag)
					ElementSettings = ElementSettings or {}
