						local n = tonumber(v)
						return n and math.clamp(n, lo, hi) or lo
					end

					local function syncVisualsFromHsv()
						local c = Color3.fromHSV(hue, sat, val)
						local alphaVal = isAlpha and clampNum(modifierInputs.Alpha.Text, 0, 1) or 0
						newWellColor.BackgroundColor3 = c
						newWellColor.BackgroundTransparency = alphaVal
						valSlider.BackgroundColor3 = Color3.fromHSV(hue, sat, 1)
						modifierInputs.Red.Text = tostring(math.floor(c.R * 255 + 0.5))
						modifierInputs.Green.Text = tostring(math.floor(c.G * 255 + 0.5))
						modifierInputs.Blue.Text = tostring(math.floor(c.B * 255 + 0.5))
						if isAlpha then modifierInputs.Alpha.Text = tostring(alphaVal) end
						modifierInputs.Hex.Text = string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
					end

					local function updateRingFromPos(posX, posY)
						local r = wheelBtn.AbsoluteSize.X / 2
						if r <= 0 then return end
						local d = Vector2.new(posX, posY) - wheelBtn.AbsolutePosition - wheelBtn.AbsoluteSize / 2
						if d:Dot(d) > r * r then d = d.Unit * r end
						targetRing.Position = UDim2.new(0.5, d.X, 0.5, d.Y)
						local phi = math.atan2(-d.Y, d.X)
						local len = d.Magnitude
						hue = (((phi + math.pi) / (2 * math.pi)) * 360) / 360
						sat = math.clamp(len / r, 0, 1)
						syncVisualsFromHsv()
					end

					local function updateSlideFromPos(posX)
						local maxX = math.max(1, valSlider.AbsoluteSize.X - slideKnob.AbsoluteSize.X)
						local clampedX = math.clamp(posX - valSlider.AbsolutePosition.X, 0, maxX)
						slideKnob.Position = UDim2.new(0, clampedX, 0.5, 0)
						val = 1 - (clampedX / maxX)
						syncVisualsFromHsv()
					end

					local function applyColorToPicker(newColor3, newAlpha, fireCb)
						ColorpickerFunctions.Color = newColor3
						if isAlpha and newAlpha ~= nil then
							ColorpickerFunctions.Alpha = clampNum(newAlpha, 0, 1)
						end
						colorC.BackgroundColor3 = ColorpickerFunctions.Color
						colorC.BackgroundTransparency = ColorpickerFunctions.Alpha
						oldWellColor.BackgroundColor3 = ColorpickerFunctions.Color
						oldWellColor.BackgroundTransparency = ColorpickerFunctions.Alpha
						newWellColor.BackgroundColor3 = ColorpickerFunctions.Color
						newWellColor.BackgroundTransparency = ColorpickerFunctions.Alpha

						hue, sat, val = ColorpickerFunctions.Color:ToHSV()
						local r = wheelBtn.AbsoluteSize.X / 2
						if r > 0 then
							local phi = hue * 2 * math.pi
							local len = sat * r
							targetRing.Position = UDim2.new(0.5, -len * math.cos(phi), 0.5, len * math.sin(phi))
						end
						local maxX = math.max(1, valSlider.AbsoluteSize.X - slideKnob.AbsoluteSize.X)
						slideKnob.Position = UDim2.new(0, (1 - val) * maxX, 0.5, 0)
						valSlider.BackgroundColor3 = Color3.fromHSV(hue, sat, 1)

						local rByte = math.floor(ColorpickerFunctions.Color.R * 255 + 0.5)
						local gByte = math.floor(ColorpickerFunctions.Color.G * 255 + 0.5)
						local bByte = math.floor(ColorpickerFunctions.Color.B * 255 + 0.5)
						modifierInputs.Red.Text = tostring(rByte)
						modifierInputs.Green.Text = tostring(gByte)
						modifierInputs.Blue.Text = tostring(bByte)
						if isAlpha then modifierInputs.Alpha.Text = tostring(ColorpickerFunctions.Alpha) end
						modifierInputs.Hex.Text = string.format("#%02X%02X%02X", rByte, gByte, bByte)

						if fireCb and ElementSettings.Callback then
							pcall(ElementSettings.Callback, ColorpickerFunctions.Color, isAlpha and ColorpickerFunctions.Alpha or nil)
						end
					end

					applyColorToPicker(defaultCol, ColorpickerFunctions.Alpha, false)

					wheelBtn.InputBegan:Connect(function(inp)
						if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
							wheelDown = true
							updateRingFromPos(inp.Position.X, inp.Position.Y)
						end
					end)
					valSlider.InputBegan:Connect(function(inp)
						if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
							slideDown = true
