					local binderBox = Instance.new("TextBox")
					binderBox.Name = "BinderBox"
					binderBox.CursorPosition = -1
					binderBox.FontFace = Font.new(assets.interFont)
					binderBox.PlaceholderText = "..."
					binderBox.TextColor3 = Color3.fromRGB(255, 255, 255)
					binderBox.TextSize = 12
					binderBox.TextTransparency = 0.1
					binderBox.AnchorPoint = Vector2.new(1, 0.5)
					binderBox.AutomaticSize = Enum.AutomaticSize.X
					binderBox.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
					binderBox.BackgroundTransparency = 0.95
					binderBox.ClipsDescendants = true
					binderBox.LayoutOrder = 1
					binderBox.Position = UDim2.fromScale(1, 0.5)
					binderBox.Size = UDim2.fromOffset(21, 21)
					binderBox.Parent = keybind

					Instance.new("UICorner", binderBox).CornerRadius = UDim.new(0, 4)
					local bbStroke = Instance.new("UIStroke", binderBox)
					bbStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
					bbStroke.Color = Color3.fromRGB(255, 255, 255)
					bbStroke.Transparency = 0.9
					local bbPad = Instance.new("UIPadding", binderBox)
					bbPad.PaddingLeft = UDim.new(0, 5)
					bbPad.PaddingRight = UDim.new(0, 5)

					local function formatKey(k)
						if not k or k == Enum.KeyCode.Unknown then return "None" end
						if k == Enum.UserInputType.MouseButton3 then return "Mouse3" end
						return typeof(k) == "EnumItem" and k.Name or tostring(k)
					end

					local function matchesInput(inp)
						if not binded or binded == Enum.KeyCode.Unknown then return false end
						if binded == Enum.UserInputType.MouseButton3 then
							return inp.UserInputType == Enum.UserInputType.MouseButton3
						end
						return inp.KeyCode == binded or inp.UserInputType == binded
					end

					local function triggerBindCallback()
						if not ElementSettings.Callback then return end
						if ElementSettings.Risky then
							showRiskyConfirm(function() pcall(ElementSettings.Callback, binded) end, nil, typeof(ElementSettings.Risky) == "string" and ElementSettings.Risky or nil)
						elseif ElementSettings.Beta then
							showBetaConfirm(function() pcall(ElementSettings.Callback, binded) end, nil, typeof(ElementSettings.Beta) == "string" and ElementSettings.Beta or nil)
						else
							pcall(ElementSettings.Callback, binded)
						end
					end

					binderBox.Text = formatKey(binded)

					local listening = false
					binderBox.Focused:Connect(function()
						listening = true
						binderBox.Text = "..."
					end)
					binderBox.FocusLost:Connect(function()
						if listening then
							binderBox.Text = formatKey(binded)
							listening = false
						end
					end)

					UserInputService.InputBegan:Connect(function(inp, gpe)
						if listening then
							local isMiddle = inp.UserInputType == Enum.UserInputType.MouseButton3
							if inp.KeyCode ~= Enum.KeyCode.Unknown or isMiddle or inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.MouseButton2 then
								if inp.KeyCode == Enum.KeyCode.Escape then
									binded = Enum.KeyCode.Unknown
								elseif isMiddle then
									binded = Enum.UserInputType.MouseButton3
								elseif inp.UserInputType == Enum.UserInputType.Keyboard then
									binded = inp.KeyCode
								else
									binded = inp.UserInputType
								end
								KeybindFunctions.Bind = binded
								binderBox.Text = formatKey(binded)
								listening = false
								binderBox:ReleaseFocus()
								if ElementSettings.onBinded then
									pcall(ElementSettings.onBinded, binded)
								end
							end
							return
						end

						if not gpe and not UserInputService:GetFocusedTextBox() and matchesInput(inp) then
							triggerBindCallback()
							if ElementSettings.onBindHeld then
								pcall(ElementSettings.onBindHeld, true, binded)
							end
						end
					end)

					UserInputService.InputEnded:Connect(function(inp)
						if not listening and matchesInput(inp) and ElementSettings.onBindHeld then
							pcall(ElementSettings.onBindHeld, false, binded)
						end
					end)

					function KeybindFunctions:BindKey(Key)
						binded = Key or Enum.KeyCode.Unknown
						KeybindFunctions.Bind = binded
						binderBox.Text = formatKey(binded)
					end
					function KeybindFunctions:Unbind()
						binded = Enum.KeyCode.Unknown
						KeybindFunctions.Bind = binded
						binderBox.Text = "None"
					end
					function KeybindFunctions:GetBind() return binded end
					function KeybindFunctions:Get() return binded end
					function KeybindFunctions:Set(Key) KeybindFunctions:BindKey(Key) end
					function KeybindFunctions:UpdateName(Name) keybindName.Text = Name end
					function KeybindFunctions:SetVisibility(State) keybind.Visible = State end

					if Flag then MacLib.Options[Flag] = KeybindFunctions end
					return KeybindFunctions
				end

