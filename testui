							wheelDown = false
							slideDown = false
						end
					end)
					UserInputService.InputChanged:Connect(function(inp)
						if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
							if wheelDown then updateRingFromPos(inp.Position.X, inp.Position.Y) end
							if slideDown then updateSlideFromPos(inp.Position.X) end
						end
					end)

					local function syncRgbBoxes()
						local r = clampNum(modifierInputs.Red.Text, 0, 255)
						local g = clampNum(modifierInputs.Green.Text, 0, 255)
						local b = clampNum(modifierInputs.Blue.Text, 0, 255)
						applyColorToPicker(Color3.fromRGB(r, g, b), isAlpha and clampNum(modifierInputs.Alpha.Text, 0, 1) or 0, false)
					end
					modifierInputs.Red.FocusLost:Connect(syncRgbBoxes)
