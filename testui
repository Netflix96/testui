			end
		})
	end

	local function resolveGuard(elementSettings, intendedTrue)
		local lockReason = elementSettings.Locked
			and (typeof(elementSettings.Locked) == "string" and elementSettings.Locked or DEFAULT_LOCK_REASON)
			or nil
		if lockReason then
			if intendedTrue then showLockedNotice(lockReason) end
			return false, true
		end
		if elementSettings.Risky then
			return "risky", false
		end
		if elementSettings.Beta then
			return "beta", false
		end
		return nil, false
	end

	local function attachLockBadge(rowFrame, controlObj, initialReason)
		local lockReason = initialReason
		local pill = Instance.new("Frame")
		pill.Name = "LockedBadge"
