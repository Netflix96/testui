	local function showLockedNotice(reason)
		showGuardModal({
			Title = "Locked",
			Body = reason or DEFAULT_LOCK_REASON,
			Icon = "lock",
			Accent = K.sub,
			SingleButton = true,
		})
	end

	local function showRiskyConfirm(onYes, onNo, customText)
		if riskyAcknowledged then
			if onYes then onYes() end
			return
		end
		if riskyModalOpen then
			table.insert(riskyQueue, { onYes, onNo, customText })
			return
		end
		riskyModalOpen = true
		showGuardModal({
			Title = "Risky Feature",
			Body = customText or "Red features can get you detected or break stuff. Only turn them on if you know what they do.",
			Icon = "triangle-alert",
			Accent = RISKY,
			OnClose = function(confirmed)
				riskyModalOpen = false
				if confirmed then
					riskyAcknowledged = true
					if onYes then onYes() end
				elseif onNo then
					onNo()
				end
				local nextItem = table.remove(riskyQueue, 1)
				if nextItem then
					task.defer(showRiskyConfirm, nextItem[1], nextItem[2], nextItem[3])
				end
			end
		})
	end

	local function showBetaConfirm(onYes, onNo, customText)
		if betaAcknowledged then
			if onYes then onYes() end
			return
		end
		if betaModalOpen then
			table.insert(betaQueue, { onYes, onNo, customText })
			return
		end
		betaModalOpen = true
		showGuardModal({
