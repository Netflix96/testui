		notificationDescription.TextTransparency = 0.5
		notificationDescription.TextWrapped = true
		notificationDescription.RichText = true
		notificationDescription.TextXAlignment = Enum.TextXAlignment.Left
		notificationDescription.TextYAlignment = Enum.TextYAlignment.Top
		notificationDescription.AutomaticSize = Enum.AutomaticSize.XY
		notificationDescription.BackgroundTransparency = 1
		notificationDescription.Size = UDim2.new(1, -12, 0, 0)
		local dPad = Instance.new("UIPadding", notificationDescription)
		dPad.PaddingRight = UDim.new(0, 25)
		dPad.PaddingTop = UDim.new(0, 17)

		local inTween = Tween(notificationUIScale, TweenInfo.new(0.2, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), { Scale = NotifSettings.Scale or 1 })
		local outTween = Tween(notificationUIScale, TweenInfo.new(0.2, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), { Scale = 0 })

		local animThread = task.spawn(function()
			inTween:Play()
			local life = NotifSettings.Lifetime or NotifSettings.Duration or 3
			if life ~= 0 then
				task.wait(life)
				outTween:Play()
				outTween.Completed:Wait()
				notification:Destroy()
			end
		end)

		function NotificationFunctions:UpdateTitle(New) notificationTitle.Text = New end
		function NotificationFunctions:UpdateDescription(New) notificationDescription.Text = New end
		function NotificationFunctions:Resize(X) notification.Size = UDim2.fromOffset(X or 250, 0) end
		function NotificationFunctions:Cancel()
			pcall(task.cancel, animThread)
			outTween:Play()
			outTween.Completed:Wait()
			notification:Destroy()
		end

		return NotificationFunctions
	end

