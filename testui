				function SecFuncs:Keybind(ElementSettings, Flag)
					ElementSettings = ElementSettings or {}
					local binded = ElementSettings.Default or Enum.KeyCode.Unknown
					local KeybindFunctions = {
						Settings = ElementSettings,
						IgnoreConfig = false,
						Class = "Keybind",
						Bind = binded,
					}

