			if not state then
				Tween(checkmark, TweenInfo.new(0.2, Enum.EasingStyle.Quint), { Size = UDim2.new(checkmark.Size.X.Scale, -10, checkmark.Size.Y.Scale, checkmark.Size.Y.Offset) }):Play()
				Tween(settingName, TweenInfo.new(0.2, Enum.EasingStyle.Quint), { TextTransparency = 0.5 }):Play()
				checkmark.TextTransparency = 1
			else
				Tween(checkmark, TweenInfo.new(0.2, Enum.EasingStyle.Quint), { Size = UDim2.new(checkmark.Size.X.Scale, 12, checkmark.Size.Y.Scale, checkmark.Size.Y.Offset) }):Play()
				Tween(settingName, TweenInfo.new(0.2, Enum.EasingStyle.Quint), { TextTransparency = 0.2 }):Play()
				checkmark.TextTransparency = 0
			end
		end

		local toggled = ElementSettings.Default == true
		applyGlobalToggle(toggled)

		globalSetting.MouseButton1Click:Connect(function()
			toggled = not toggled
			applyGlobalToggle(toggled)
			task.spawn(function()
				if ElementSettings.Callback then
					ElementSettings.Callback(toggled)
				end
			end)
		end)

		function GlobalSettingFunctions:UpdateName(NewName) settingName.Text = NewName end
		function GlobalSettingFunctions:UpdateState(NewState)
			toggled = NewState == true
			applyGlobalToggle(toggled)
		end

		return GlobalSettingFunctions
