					local function setOptionState(optionName, state)
						local optObj = OptionObjs[optionName]
						if not optObj then return end
						if state then
							if isMulti then
								if not table.find(Selected, optionName) then
									table.insert(Selected, optionName)
								end
							else
								for otherName, otherObj in pairs(OptionObjs) do
