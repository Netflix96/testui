		NotifSettings = NotifSettings or {}
		local NotificationFunctions = {}
		local maxW = math.max(180, math.min(NotifSettings.SizeX or 250, Camera.ViewportSize.X - 24))

		local notification = Instance.new("Frame", notifications)
		notification.Name = "Notification"
		notification.AnchorPoint = Vector2.new(0.5, 0.5)
		notification.AutomaticSize = Enum.AutomaticSize.Y
		notification.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
		notification.BorderSizePixel = 0
		notification.Position = UDim2.fromScale(0.5, 0.5)
		notification.Size = UDim2.fromOffset(maxW, 0)

		local nStroke = Instance.new("UIStroke", notification)
		nStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		nStroke.Color = Color3.fromRGB(255, 255, 255)
		nStroke.Transparency = 0.9
		Instance.new("UICorner", notification).CornerRadius = UDim.new(0, 10)
		local notificationUIScale = Instance.new("UIScale", notification)
		notificationUIScale.Scale = 0

		local notificationInformation = Instance.new("Frame", notification)
		notificationInformation.AutomaticSize = Enum.AutomaticSize.Y
		notificationInformation.BackgroundTransparency = 1
		notificationInformation.Size = UDim2.fromScale(1, 1)
		local nPad = Instance.new("UIPadding", notificationInformation)
		nPad.PaddingTop = UDim.new(0, 10)
		nPad.PaddingBottom = UDim.new(0, 12)
		nPad.PaddingLeft = UDim.new(0, 10)
		nPad.PaddingRight = UDim.new(0, 10)

		local notificationTitle = Instance.new("TextLabel", notificationInformation)
		notificationTitle.FontFace = Font.new(assets.interFont, Enum.FontWeight.SemiBold)
		notificationTitle.RichText = true
		notificationTitle.Text = NotifSettings.Title or ""
		notificationTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
		notificationTitle.TextSize = 13
		notificationTitle.TextTransparency = 0.2
		notificationTitle.TextXAlignment = Enum.TextXAlignment.Left
		notificationTitle.TextYAlignment = Enum.TextYAlignment.Top
		notificationTitle.AutomaticSize = Enum.AutomaticSize.XY
		notificationTitle.BackgroundTransparency = 1
		notificationTitle.Size = UDim2.new(1, -12, 0, 0)
		Instance.new("UIPadding", notificationTitle).PaddingRight = UDim.new(0, 12)

		local notificationDescription = Instance.new("TextLabel", notificationInformation)
		notificationDescription.FontFace = Font.new(assets.interFont, Enum.FontWeight.Medium)
		notificationDescription.Text = NotifSettings.Description or NotifSettings.Text or ""
		notificationDescription.TextColor3 = Color3.fromRGB(255, 255, 255)
		notificationDescription.TextSize = 11
		notificationDescription.TextTransparency = 0.5
		notificationDescription.TextWrapped = true
		notificationDescription.RichText = true
		notificationDescription.TextXAlignment = Enum.TextXAlignment.Left
		notificationDescription.TextYAlignment = Enum.TextYAlignment.Top
		notificationDescription.AutomaticSize = Enum.AutomaticSize.XY
		notificationDescription.BackgroundTransparency = 1
		notificationDescription.Size = UDim2.new(1, -12, 0, 0)
		local dPad = Instance.new("UIPadding", notificationDescription)
		dPad.PaddingRight = UDim.new(0, 12)
		dPad.PaddingTop = UDim.new(0, 17)

		local inTween = Tween(notificationUIScale, TweenInfo.new(0.2, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), { Scale = NotifSettings.Scale or 1 })
		local outTween = Tween(notificationUIScale, TweenInfo.new(0.2, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), { Scale = 0 })

		local animThread = task.spawn(function()
			inTween:Play()
			local life = NotifSettings.Lifetime or NotifSettings.Duration or 3
			if life ~= 0 then
				task.wait(life)
				outTween:Play()
				outTween.Completed:Wait()
				notification:Destroy()
			end
		end)

		function NotificationFunctions:UpdateTitle(New) notificationTitle.Text = New end
		function NotificationFunctions:UpdateDescription(New) notificationDescription.Text = New end
		function NotificationFunctions:Resize(X) notification.Size = UDim2.fromOffset(X or maxW, 0) end
		function NotificationFunctions:Cancel()
			pcall(task.cancel, animThread)
			outTween:Play()
			outTween.Completed:Wait()
			notification:Destroy()
		end

		return NotificationFunctions
	end

