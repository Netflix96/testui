	local function makeVantixRow(parent, opts)
		local hasDesc = opts.Description and opts.Description ~= ""
		local flagText = opts.Risky and "RISKY" or (opts.Beta and "BETA" or nil)
		local flagCol  = opts.Risky and RISKY or (opts.Beta and BETA or nil)

		local row = Instance.new("Frame")
		row.Name = "VantixRow"
		row.BackgroundColor3 = K.surface
		row.BorderSizePixel = 0
		row.Size = UDim2.new(1, 0, 0, hasDesc and 54 or 44)
		row.Parent = parent
		Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

		local rStroke = Instance.new("UIStroke", row)
		rStroke.Color = K.border
		rStroke.Transparency = 0.2

		local rowPad = Instance.new("UIPadding", row)
		rowPad.PaddingLeft = UDim.new(0, 10)
		rowPad.PaddingRight = UDim.new(0, 10)

		local rightClusterW = opts.RightClusterWidth or 24
		local rightCluster = Instance.new("Frame")
		rightCluster.Name = "RightCluster"
		rightCluster.AnchorPoint = Vector2.new(1, 0.5)
		rightCluster.Position = UDim2.new(1, 0, 0.5, 0)
		rightCluster.Size = UDim2.new(0, rightClusterW, 1, 0)
		rightCluster.BackgroundTransparency = 1
		rightCluster.ZIndex = 6
		rightCluster.Parent = row

		local badgeStrip = Instance.new("Frame")
		badgeStrip.Name = "BadgeStrip"
		badgeStrip.AnchorPoint = Vector2.new(1, 0.5)
		badgeStrip.Position = UDim2.new(1, -(rightClusterW + 6), 0.5, 0)
		badgeStrip.Size = UDim2.new(0, 0, 0, 20)
		badgeStrip.AutomaticSize = Enum.AutomaticSize.X
		badgeStrip.BackgroundTransparency = 1
		badgeStrip.ZIndex = 5
		badgeStrip.Parent = row

		local badgeLayout = Instance.new("UIListLayout", badgeStrip)
		badgeLayout.FillDirection = Enum.FillDirection.Horizontal
		badgeLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
		badgeLayout.VerticalAlignment = Enum.VerticalAlignment.Center
		badgeLayout.SortOrder = Enum.SortOrder.LayoutOrder
		badgeLayout.Padding = UDim.new(0, 4)

		local flagPill
		if flagText and flagCol then
			flagPill = Instance.new("Frame")
			flagPill.Name = "FlagPill"
			flagPill.BackgroundColor3 = flagCol
			flagPill.BackgroundTransparency = 0.85
			flagPill.Size = UDim2.new(0, 0, 0, 18)
			flagPill.AutomaticSize = Enum.AutomaticSize.X
			flagPill.LayoutOrder = 1
			flagPill.Parent = badgeStrip
			Instance.new("UICorner", flagPill).CornerRadius = UDim.new(0, 4)

			local fpStroke = Instance.new("UIStroke", flagPill)
			fpStroke.Color = flagCol
			fpStroke.Transparency = 0.5

			local fpPad = Instance.new("UIPadding", flagPill)
			fpPad.PaddingLeft = UDim.new(0, 5)
			fpPad.PaddingRight = UDim.new(0, 5)

			local fpLbl = Instance.new("TextLabel")
			fpLbl.BackgroundTransparency = 1
			fpLbl.FontFace = Font.new(assets.interFont, Enum.FontWeight.Bold)
			fpLbl.Text = flagText
			fpLbl.TextColor3 = flagCol
			fpLbl.TextSize = 10
			fpLbl.Size = UDim2.new(0, 0, 1, 0)
			fpLbl.AutomaticSize = Enum.AutomaticSize.X
			fpLbl.Parent = flagPill
		end

		local lockReason = opts.Locked
			and (typeof(opts.Locked) == "string" and opts.Locked or DEFAULT_LOCK_REASON)
			or nil

		local lockPill = Instance.new("Frame")
		lockPill.Name = "LockedBadge"
		lockPill.BackgroundColor3 = K.raised
		lockPill.Size = UDim2.new(0, 0, 0, 18)
		lockPill.AutomaticSize = Enum.AutomaticSize.X
		lockPill.LayoutOrder = 2
		lockPill.Visible = lockReason ~= nil
		lockPill.Parent = badgeStrip
		Instance.new("UICorner", lockPill).CornerRadius = UDim.new(1, 0)

		local lpStroke = Instance.new("UIStroke", lockPill)
		lpStroke.Color = K.borderHi
		lpStroke.Transparency = 0.3

		local lpPad = Instance.new("UIPadding", lockPill)
		lpPad.PaddingLeft = UDim.new(0, 6)
		lpPad.PaddingRight = UDim.new(0, 6)

		local lpLbl = Instance.new("TextLabel")
		lpLbl.BackgroundTransparency = 1
		lpLbl.FontFace = Font.new(assets.interFont, Enum.FontWeight.Medium)
		lpLbl.Text = "Locked"
		lpLbl.TextColor3 = K.muted
		lpLbl.TextSize = 10
		lpLbl.Size = UDim2.new(0, 0, 1, 0)
		lpLbl.AutomaticSize = Enum.AutomaticSize.X
		lpLbl.Parent = lockPill

		local textCol = Instance.new("Frame")
		textCol.Name = "TextCol"
		textCol.Position = UDim2.new(0, 0, 0, 0)
		textCol.Size = UDim2.new(1, -(rightClusterW + 8), 1, 0)
		textCol.BackgroundTransparency = 1
		textCol.ClipsDescendants = true
		textCol.Parent = row

		local function resizeTextCol()
			local badgesW = badgeStrip.AbsoluteSize.X
			local reserve = rightClusterW + (badgesW > 0 and (badgesW + 10) or 4)
			textCol.Size = UDim2.new(1, -reserve, 1, 0)
		end
		badgeStrip:GetPropertyChangedSignal("AbsoluteSize"):Connect(resizeTextCol)
		task.defer(resizeTextCol)

		local lbl = Instance.new("TextLabel")
		lbl.BackgroundTransparency = 1
		lbl.FontFace = Font.new(assets.interFont, Enum.FontWeight.Medium)
		lbl.Text = opts.Title or ""
		lbl.TextColor3 = flagCol or K.text
		lbl.TextSize = 13
		lbl.TextTruncate = Enum.TextTruncate.AtEnd
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		lbl.Size = hasDesc and UDim2.new(1, 0, 0, 18) or UDim2.new(1, 0, 1, 0)
		lbl.Position = hasDesc and UDim2.new(0, 0, 0, 8) or UDim2.new(0, 0, 0, 0)
		lbl.Parent = textCol

		local subLbl
		if hasDesc then
			subLbl = Instance.new("TextLabel")
			subLbl.BackgroundTransparency = 1
			subLbl.FontFace = Font.new(assets.interFont)
			subLbl.Text = opts.Description
			subLbl.TextColor3 = K.muted
			subLbl.TextSize = 11
			subLbl.TextTruncate = Enum.TextTruncate.AtEnd
			subLbl.TextXAlignment = Enum.TextXAlignment.Left
			subLbl.Size = UDim2.new(1, 0, 0, 15)
			subLbl.Position = UDim2.new(0, 0, 0, 28)
			subLbl.Parent = textCol
		end

		local function applyLock(on, reason)
			lockReason = on and (typeof(reason) == "string" and reason or DEFAULT_LOCK_REASON) or nil
			lockPill.Visible = on
			local fade = on and 0.55 or 0
			lbl.TextTransparency = math.max(lbl.TextTransparency, fade)
			if subLbl then subLbl.TextTransparency = math.max(subLbl.TextTransparency, fade) end
			if flagPill then flagPill.BackgroundTransparency = on and 0.94 or 0.85 end
			task.defer(resizeTextCol)
		end

		if lockReason then applyLock(true, lockReason) end

		return {
			Row = row,
			Stroke = rStroke,
			RightCluster = rightCluster,
			TitleLabel = lbl,
			DescLabel = subLbl,
			SetLocked = applyLock,
			GetReason = function() return lockReason end,
		}
	end

