					sliderTouch.AutoButtonColor = false
					sliderTouch.Size = UDim2.new(1, -54, 0, 26)

					local sliderBar = Instance.new("ImageLabel", sliderTouch)
					sliderBar.Name = "SliderBar"
					sliderBar.Image = assets.sliderbar
					sliderBar.ImageColor3 = flagCol or Color3.fromRGB(87, 86, 86)
					sliderBar.BackgroundTransparency = 1
					sliderBar.AnchorPoint = Vector2.new(0.5, 0.5)
					sliderBar.Position = UDim2.fromScale(0.5, 0.5)
					sliderBar.Size = UDim2.new(1, -12, 0, 3)

					local sliderHead = Instance.new("ImageButton", sliderBar)
					sliderHead.Name = "SliderHead"
					sliderHead.Image = assets.sliderhead
					sliderHead.AnchorPoint = Vector2.new(0.5, 0.5)
					sliderHead.BackgroundTransparency = 1
					sliderHead.Position = UDim2.fromScale(0, 0.5)
					sliderHead.Size = UDim2.fromOffset(16, 16)

					local DisplayMethods = {
						Hundredths = function(v) return string.format("%.2f", v) end,
						Tenths = function(v) return string.format("%.1f", v) end,
						Round = function(v, p) return p and string.format("%." .. p .. "f", v) or tostring(math.round(v)) end,
						Degrees = function(v, p) return (p and string.format("%." .. p .. "f", v) or tostring(math.round(v))) .. "°" end,
						Percent = function(v, p)
							local pct = maxV == minV and 0 or ((v - minV) / (maxV - minV)) * 100
							return (p and string.format("%." .. p .. "f", pct) or tostring(math.round(pct))) .. "%"
						end,
						Value = function(v, p) return p and string.format("%." .. p .. "f", v) or tostring(math.round(v)) end,
					}
					local displayMethod = DisplayMethods[ElementSettings.DisplayMethod] or DisplayMethods.Value

					local function applySliderValue(rawVal, silent)
						local nv = math.clamp(tonumber(rawVal) or minV, minV, maxV)
						if ElementSettings.Precision then
							local mult = 10 ^ ElementSettings.Precision
							nv = math.round(nv * mult) / mult
						end
						local pct = maxV == minV and 0 or math.clamp((nv - minV) / (maxV - minV), 0, 1)
						sliderHead.Position = UDim2.new(pct, 0, 0.5, 0)
						SliderFunctions.Value = nv
						sliderValue.Text = (ElementSettings.Prefix or "") .. displayMethod(nv, ElementSettings.Precision) .. (ElementSettings.Suffix or "")
						if not silent and ElementSettings.Callback then
							pcall(ElementSettings.Callback, nv)
						end
					end

					applySliderValue(defaultV, true)

					local dragging = false
					local function updateFromInput(input)
						if sliderBar.AbsoluteSize.X <= 0 then return end
						local pct = math.clamp((input.Position.X - sliderBar.AbsolutePosition.X) / sliderBar.AbsoluteSize.X, 0, 1)
						local nv = minV + pct * (maxV - minV)
						if nv ~= SliderFunctions.Value then
							applySliderValue(nv, false)
						end
					end

					local function beginSlide(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
							dragging = true
							updateFromInput(input)
						end
					end
					sliderTouch.InputBegan:Connect(beginSlide)
					sliderHead.InputBegan:Connect(beginSlide)

					local function endSlide(input)
						if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
							dragging = false
							if ElementSettings.onInputComplete then
								pcall(ElementSettings.onInputComplete, SliderFunctions.Value)
							end
						end
					end
					sliderTouch.InputEnded:Connect(endSlide)
					sliderHead.InputEnded:Connect(endSlide)
					UserInputService.InputEnded:Connect(endSlide)

					UserInputService.InputChanged:Connect(function(input)
						if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
							updateFromInput(input)
						end
					end)

					sliderValue.FocusLost:Connect(function()
						local numStr, pctSign = sliderValue.Text:match("^(%-?%d+%.?%d*)(%%?)$")
						if numStr then
							local parsed = tonumber(numStr)
							if parsed then
								if pctSign == "%" then
									parsed = minV + (parsed / 100) * (maxV - minV)
								end
								applySliderValue(parsed, false)
							end
						else
							applySliderValue(SliderFunctions.Value, true)
						end
						if ElementSettings.onInputComplete then
							pcall(ElementSettings.onInputComplete, SliderFunctions.Value)
						end
					end)

					function SliderFunctions:UpdateName(Name) sliderName.Text = Name end
					function SliderFunctions:SetVisibility(State) slider.Visible = State end
					function SliderFunctions:UpdateValue(Value, silent) applySliderValue(Value, silent) end
					function SliderFunctions:Set(Value, silent) applySliderValue(Value, silent) end
					function SliderFunctions:GetValue() return SliderFunctions.Value end
					function SliderFunctions:Get() return SliderFunctions.Value end

					if Flag then MacLib.Options[Flag] = SliderFunctions end
					return SliderFunctions
				end

