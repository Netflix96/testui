						modifierInputs.Blue.Text = tostring(bByte)
						if isAlpha then modifierInputs.Alpha.Text = tostring(ColorpickerFunctions.Alpha) end
						modifierInputs.Hex.Text = string.format("#%02X%02X%02X", rByte, gByte, bByte)

