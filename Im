						local r = wheelBtn.AbsoluteSize.X / 2
						if r > 0 then
							local phi = hue * 2 * math.pi
							local len = sat * r
							targetRing.Position = UDim2.new(0.5, -len * math.cos(phi), 0.5, len * math.sin(phi))
						end
						local maxX = math.max(1, valSlider.AbsoluteSize.X - slideKnob.AbsoluteSize.X)
						slideKnob.Position = UDim2.new(0, (1 - val) * maxX, 0.5, 0)
						valSlider.BackgroundColor3 = Color3.fromHSV(hue, sat, 1)

						local rByte = math.floor(ColorpickerFunctions.Color.R * 255 + 0.5)
						local gByte = math.floor(ColorpickerFunctions.Color.G * 255 + 0.5)
						local bByte = math.floor(ColorpickerFunctions.Color.B * 255 + 0.5)
