							twVantix(trackStroke, { Color = K.borderHi }, 0.14):Play()
							twVantix(knob, { BackgroundColor3 = K.muted, Position = UDim2.new(0, 3, 0.5, 0) }, 0.16):Play()
						end
						if not silent and ElementSettings.Callback then
							pcall(ElementSettings.Callback, ToggleFunctions.State)
						end
					end

					renderToggle(ToggleFunctions.State, true)

					local function commitState(newState, silent)
						if newState and built.GetReason() then
							showLockedNotice(built.GetReason())
							return
						end
						renderToggle(newState, silent)
					end

					local function requestToggle()
						local targetState = not ToggleFunctions.State
						if built.GetReason() then
							showLockedNotice(built.GetReason())
							return
						end
						if targetState and ElementSettings.Risky then
							showRiskyConfirm(
								function() commitState(true, false) end,
								nil,
								typeof(ElementSettings.Risky) == "string" and ElementSettings.Risky or nil
							)
						elseif targetState and ElementSettings.Beta then
							showBetaConfirm(
								function() commitState(true, false) end,
								nil,
								typeof(ElementSettings.Beta) == "string" and ElementSettings.Beta or nil
							)
						else
							commitState(targetState, false)
						end
					end

					hitBtn.MouseButton1Click:Connect(requestToggle)

					function ToggleFunctions:Toggle() requestToggle() end
					function ToggleFunctions:UpdateState(State, silent)
						if State and built.GetReason() then return end
						commitState(State == true, silent)
					end
					function ToggleFunctions:Set(State, silent) ToggleFunctions:UpdateState(State, silent) end
					function ToggleFunctions:GetState() return ToggleFunctions.State end
					function ToggleFunctions:Get() return ToggleFunctions.State end
					function ToggleFunctions:UpdateName(Name) built.TitleLabel.Text = Name end
					function ToggleFunctions:SetVisibility(State) row.Visible = State end
					function ToggleFunctions:Lock(reason)
						if ToggleFunctions.State then
							commitState(false, false)
						end
						built.SetLocked(true, reason)
					end
					function ToggleFunctions:Unlock() built.SetLocked(false) end
					function ToggleFunctions:IsLocked() return built.GetReason() ~= nil end

					table.insert(allToggles, ToggleFunctions)
					if Flag then MacLib.Options[Flag] = ToggleFunctions end
					return ToggleFunctions
				end

