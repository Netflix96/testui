					function InputFunctions:SetVisibility(State) input.Visible = State end
					function InputFunctions:GetInput() return InputFunctions.Text end
					function InputFunctions:Get() return InputFunctions.Text end
					function InputFunctions:UpdatePlaceholder(Placeholder) inputBox.PlaceholderText = Placeholder end
					function InputFunctions:UpdateText(Text, silent)
						local filtered = filterFn(tostring(Text or ""))
						inputBox.Text = filtered
						InputFunctions.Text = filtered
						if not silent and ElementSettings.Callback then
							pcall(ElementSettings.Callback, filtered, false)
						end
					end
					function InputFunctions:Set(Text, silent) InputFunctions:UpdateText(Text, silent) end

					if Flag then MacLib.Options[Flag] = InputFunctions end
					return InputFunctions
				end

